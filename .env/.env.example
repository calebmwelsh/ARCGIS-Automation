# ArcGIS Automation Environment Variables

# Search Scope (Options: county, zip, city)
SEARCH_SCOPE_TYPE=zip
SEARCH_SCOPE_VALUE=46060

# Year Built Filter (Options: any, exactly, before, after, between)
YEAR_BUILT_CONDITION=any
YEAR_BUILD_1=
YEAR_BUILD_2=

# Data Output Options (Comma-separated field names, or '*' for all)
DATA_OUTPUT_OPTIONS=*

# Result Record Count
RESULT_RECORD_COUNT=50

# Fallback Feature Service URL (Used if search scope doesn't map to a profile)
ARCGIS_FEATURE_SERVICE_URL=https://gisdata.in.gov/server/rest/services/Hosted/Parcel_Boundaries_of_Indiana_Current/FeatureServer/0

# Optional: Add any API keys or other credentials below
